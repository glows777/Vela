{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["taskkill.exe", "where.exe"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/eval/run.ts",
        "scripts/eval/worker.ts",
        "examples/**/*.ts",
        ".skills/**/scripts/*.ts",
        "test/**/*.test.ts",
        "test/fixtures/mcp-echo-server.ts",
        "test/support/github-setup-gh.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "test/**/*.ts",
        "examples/**/*.ts",
        ".skills/**/*.ts"
      ]
    },
    "packages/vela": {
      "ignore": ["dist/**"],
      "entry": [
        "src/index.ts!",
        "src/extension-api.ts!",
        "src/testing/index.ts!",
        "src/legacy-desktop.ts!",
        "src/cli/main.ts!",
        "src/driver/execution/docker-guest.ts!",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/renderer/specimen.tsx",
        "scripts/*.ts",
        "forge.config.cjs",
        "vite.*.config.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "*.mjs", "*.cjs"]
    }
  }
}
