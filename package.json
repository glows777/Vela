{
  "name": "@glows777/vela",
  "version": "0.1.0",
  "description": "An embeddable TypeScript agent SDK and terminal agent, with pi-style extensions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glows777/Vela.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "vela": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch run src/cli/main.ts",
    "start": "bun run src/cli/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "test": "bun test test/unit test/e2e",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:live": "VELA_LIVE=1 bun test test/live",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "api:update": "bun scripts/api-report.ts",
    "smoke:consumer": "bun scripts/consumer-smoke.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.0",
    "@types/node": "^25",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/provider": "^4.0.24",
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/pi-tui": "^1.0.4",
    "@hono/node-server": "^2.1.1",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.130",
    "hono": "^4.13.7",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ]
}
