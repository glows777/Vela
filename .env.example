# ─────────────────────────────────────────────
# Vela 环境变量模板 / Environment Template
# 复制为 .env 后按需填写：cp .env.example .env
# 扩展的配置也可以写在 ~/.vela/settings.json 的 extensionConfig 里（优先于这里），见 README
# ─────────────────────────────────────────────

# ── 模型 / Model ───────────────────────────
# 至少配一个 provider 的 key；其它 provider 写在 ~/.vela/models.json（见 README）
# OpenAI 兼容 API Key
OPENAI_API_KEY=sk-xxx
# 默认模型 / default model：没有 --model 或 settings.json 的 defaultModel 时用 openai/<它>
OPENAI_API_MODEL_NAME=gpt-5
# Anthropic API Key（用 --model anthropic/<模型 id>）
# ANTHROPIC_API_KEY=

# ── 可选 / Optional ────────────────────────
# 设为 mock 时使用内置 Mock 模型离线运行，无需 API Key
# VELA_MODEL=mock
# 设为 1 时每轮打印完整 system prompt
# VELA_DEBUG=1
# 自定义 Base URL（代理 / OpenAI 兼容服务），缺省为官方端点
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── Web 搜索 / Web Search ──────────────────
# 二选一即可（都配时用 Tavily）；都不配时没有 web_search / pick one (Tavily wins); without a key there is no web_search
TAVILY_API_KEY=
SERPER_API_KEY=

# ── 飞书 / Feishu（内置扩展 feishu）────────
# 不填 APP_ID / APP_SECRET 时通道不连接飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 逗号分隔的 open_id：这些发送者是 owner（能读写文件、跑命令）；其余发送者是 guest
FEISHU_OWNERS=

# ── Supabase（内置扩展 supabase）──────────
# 不填时用内置 mock 数据
SUPABASE_URL=
SUPABASE_KEY=

# ── GitHub MCP Server ──────────────────────
# stdio 传输，需 GitHub Token
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── RAG 知识库 / RAG Knowledge Base ────────
# 用于 rag_ingest / rag_search 的 embedding 模型配置（可选）
# Embedding model config for RAG (optional)
# 三项都配置才会启用知识库，缺任意一项时 RAG 自动关闭
EMBEDDING_MODEL_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_MODEL_BASE_URL=
