# ─────────────────────────────────────────────
# Vela 环境变量模板 / Environment Template
# 复制为 .env 后按需填写：cp .env.example .env
# ─────────────────────────────────────────────

# ── 必填 / Required ─────────────────────────
# OpenAI 兼容 API Key
OPENAI_API_KEY=sk-xxx
# 模型名 / Model name，如 gpt-5
OPENAI_API_MODEL_NAME=gpt-5

# ── 可选 / Optional ────────────────────────
# 设为 mock 时使用内置 Mock 模型离线运行，无需 API Key
# VELA_MODEL=mock
# 设为 1 时每轮打印完整 system prompt
# VELA_DEBUG=1
# 自定义 Base URL（代理 / OpenAI 兼容服务），缺省为官方端点
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── Web 搜索 / Web Search ──────────────────
# 二选一即可，web_search 自动检测 / pick one, auto-detected
TAVILY_API_KEY=
SERPER_API_KEY=

# ── GitHub MCP Server ──────────────────────
# stdio 传输，需 GitHub Token
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── RAG 知识库 / RAG Knowledge Base ────────
# 用于 rag_ingest / rag_search 的 embedding 模型配置（可选）
# Embedding model config for RAG (optional)
# 三项都配置才会启用知识库，缺任意一项时 RAG 自动关闭
EMBEDDING_MODEL_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_MODEL_BASE_URL=
