# ─────────────────────────────────────────────
# Vela 环境变量模板 / Environment Template
# 复制为 .env 后按需填写：cp .env.example .env
# ─────────────────────────────────────────────

# 必填 / Required
OPENAI_API_KEY=sk-xxx
OPENAI_API_MODEL_NAME=gpt-5

# 可选 / Optional
# 自定义 Base URL（代理 / OpenAI 兼容服务），缺省为官方端点
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Web 搜索服务（二选一即可，web_search 自动检测）
TAVILY_API_KEY=
SERPER_API_KEY=

# GitHub MCP Server（stdio 传输，需 GitHub Token）
GITHUB_PERSONAL_ACCESS_TOKEN=
