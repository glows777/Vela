# ─────────────────────────────────────────────
# Vela environment template
# Copy to .env and fill in what you need: cp .env.example .env
# Extension settings can also go under extensionConfig in ~/.vela/settings.json (takes precedence over this file); see the README
# ─────────────────────────────────────────────

# ── Model ──────────────────────────────────
# Set a key for at least one provider; other providers go in ~/.vela/models.json (see the README)
# OpenAI-compatible API key
OPENAI_API_KEY=sk-xxx
# Default model: used as openai/<name> when neither --model nor defaultModel in settings.json is set
OPENAI_API_MODEL_NAME=gpt-5
# Anthropic API key (use --model anthropic/<model id>)
# ANTHROPIC_API_KEY=

# ── Optional ───────────────────────────────
# mock runs the built-in offline demo model, no API key needed
# VELA_MODEL=mock
# 1 prints the full system prompt on every turn
# VELA_DEBUG=1
# Custom base URL (proxy or OpenAI-compatible service); defaults to the official endpoint
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── Web search ─────────────────────────────
# Set one (Tavily wins if both are set); without a key there is no web_search tool
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Feishu (built-in extension feishu) ─────
# Without APP_ID / APP_SECRET the channel does not connect to Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Comma-separated open_ids: these senders are owners (can read/write files and run commands); everyone else is a guest
FEISHU_OWNERS=

# ── Supabase (built-in extension supabase) ─
# Without these the extension uses built-in mock data
SUPABASE_URL=
SUPABASE_KEY=

# ── RAG knowledge base ─────────────────────
# Embedding model used by rag_ingest / rag_search (optional)
# The knowledge base is enabled only when all three are set
EMBEDDING_MODEL_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_MODEL_BASE_URL=
