# ─────────────────────────────────────────────
# Vela 环境变量模板 / Environment Template
# 复制为 .env 后按需填写：cp .env.example .env
# ─────────────────────────────────────────────

# ── 必填 / Required ─────────────────────────
# OpenAI 兼容 API Key
OPENAI_API_KEY=sk-xxx
# 模型名 / Model name，如 gpt-5
OPENAI_API_MODEL_NAME=gpt-5

# ── 可选 / Optional ────────────────────────
# 自定义 Base URL（代理 / OpenAI 兼容服务），缺省为官方端点
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── Web 搜索 / Web Search ──────────────────
# 二选一即可，web_search 自动检测 / pick one, auto-detected
TAVILY_API_KEY=
SERPER_API_KEY=

# ── GitHub MCP Server ──────────────────────
# stdio 传输，需 GitHub Token
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── RAG 知识库 / RAG Knowledge Base ────────
# 用于 rag_ingest / rag_search 的 embedding 模型配置（可选）
# Embedding model config for RAG (optional)
EMBEDING_MODEL_KEY=sk-xxx
EMBEDING_MODEL=
EMBEDING_MODEL_BASE_URL=
