{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@glows777/vela": ["./packages/vela/src/index.ts"],
      "@glows777/vela/extension-api": ["./packages/vela/src/extension-api.ts"],
      "@glows777/vela/testing": ["./packages/vela/src/testing/index.ts"],
      "@glows777/vela/legacy-desktop": ["./packages/vela/src/legacy-desktop.ts"]
    }
  },
  "exclude": [
    "**/dist",
    "node_modules",
    "packages/*/docs",
    "packages/*/examples",
    "apps"
  ]
}
