{
  "name": "@glows777/vela",
  "version": "0.8.1",
  "description": "A self-hosted AI coworker for team group chats, built on a pi-style terminal agent and TypeScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glows777/Vela.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#docker-adapter": "./dist/docker/adapter.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension-api": {
      "types": "./dist/extension-api.d.ts",
      "import": "./dist/extension-api.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./legacy-desktop": {
      "types": "./dist/legacy-desktop.d.ts",
      "import": "./dist/legacy-desktop.js"
    }
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/provider": "^4.0.37",
    "@cfworker/json-schema": "^4.1.1",
    "@earendil-works/pi-tui": "^1.0.4",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "ai": "^7.0.170",
    "diff": "8.0.4",
    "jiti": "^2.7.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "bin": {
    "vela": "dist/cli/main.js"
  }
}
