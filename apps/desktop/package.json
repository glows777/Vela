{
  "name": "@vela/desktop",
  "productName": "Vela",
  "version": "0.0.0",
  "description": "Vela desktop foundation",
  "private": true,
  "license": "MIT",
  "author": "Vela contributors",
  "main": ".vite/build/main.mjs",
  "scripts": {
    "dev": "bun run sdk:build && electron-forge start",
    "preview": "bun run sdk:build && electron-forge start -- --vela-specimen",
    "tokens": "bun scripts/tokens.ts",
    "check": "bun run sdk:build && bun scripts/tokens.ts --check && tsc -p tsconfig.main.json && tsc -p tsconfig.json && tsc -p tsconfig.tools.json && bun scripts/check.ts",
    "package": "bun run sdk:build && electron-forge package",
    "verify": "bun run sdk:build && bun scripts/verify.ts",
    "sdk:build": "bun ../../scripts/build.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "playwright": "1.65.1",
    "vite": "8.3.8",
    "@electron/asar": "4.3.2"
  }
}
